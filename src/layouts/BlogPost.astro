---
import {Image} from 'astro:assets';
import type {CollectionEntry} from 'astro:content';
import GardenLayout from './GardenLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
type Props=CollectionEntry<'blog'>['data'];
const {title,description,pubDate,updatedDate,heroImage,tags}=Astro.props;
---
<GardenLayout title={`${title} · 往日手记`} description={description} type="article" pubDate={pubDate} updatedDate={updatedDate} image={heroImage}><div id="top"></div><article class="archived-article"><a class="back-link" href="/columns/old-notes/">← 往日手记 · 旧文专栏</a><header class="article-heading"><div class="eyebrow">THE WRITING ARCHIVE</div><h1>{title}</h1><div class="article-meta"><FormattedDate date={pubDate}/>{updatedDate&&<span>更新于 <FormattedDate date={updatedDate}/></span>}<span>收录于往日手记</span></div><div class="post-tags">{tags.filter(t=>t!=='煦意熙焉').map(tag=><span>{tag}</span>)}</div></header>{heroImage&&<Image width={1020} height={510} src={heroImage} alt=""/>}<div class="article-prose"><slot/></div><div class="article-ending"><a href="/columns/old-notes/">← 返回专栏</a><a href="/learn/">去学习空间 →</a></div></article></GardenLayout>
<style>.archived-article{max-width:760px;margin:40px auto}.article-heading{padding-bottom:28px;border-bottom:1px solid var(--garden-line);margin-bottom:30px}.article-heading h1{font-size:35px;line-height:1.7;margin:16px 0}.article-meta{display:flex;gap:17px;flex-wrap:wrap;color:var(--garden-muted);font-size:10px}.article-heading .post-tags{margin-top:18px}.article-prose{font-size:15px;color:var(--garden-ink);line-height:2.1}.article-prose :global(p){margin:1.5em 0}.article-prose :global(h1),.article-prose :global(h2){font-size:25px;line-height:1.8;margin:2em 0 1em}.article-prose :global(h3){font-size:21px;line-height:1.8;margin:1.8em 0 .8em}.article-prose :global(img){display:block;max-width:100%;height:auto;margin:25px auto;border-radius:3px}.article-prose :global(blockquote){font-size:15px;border-color:#a9b88e;color:var(--garden-muted);padding:8px 20px}.article-prose :global(a){color:var(--garden-accent);text-decoration:underline;text-underline-offset:3px}.article-ending{margin-top:45px;padding-top:22px;border-top:1px solid var(--garden-line);display:flex;justify-content:space-between;font-size:11px}.article-ending a{color:var(--garden-muted)}@media(max-width:640px){.archived-article{margin:25px 0}.article-heading h1{font-size:26px}.article-prose{font-size:14px}.article-meta{font-size:9px;gap:10px}}
</style>
