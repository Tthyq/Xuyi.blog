---
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="copyright">
			&copy; {today.getFullYear()} XuYi. 保留所有权利。
		</p>
		<p class="tagline">数字花园 | 沉淀与折腾</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em 3em 1em;
		text-align: center;
	}
	.inner {
		max-width: 720px;
		margin: 0 auto;
	}
	.copyright {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		margin: 0;
	}
	.tagline {
		color: rgb(var(--gray));
		font-size: 0.85rem;
		margin: 0.5em 0 0 0;
		opacity: 0.7;
	}
</style>
