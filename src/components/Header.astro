---
const path=Astro.url.pathname;
const nav=[{href:'/',label:'首页',active:path==='/'},{href:'/learn/',label:'学习',active:path.startsWith('/learn')},{href:'/review/',label:'每日温习',active:path.startsWith('/review')},{href:'/columns/old-notes/',label:'往日手记',active:path.startsWith('/columns')||path.startsWith('/blog')},{href:'/games/',label:'游乐场',active:path.startsWith('/games')},{href:'/wall/',label:'留言墙',active:path.startsWith('/wall')},{href:'/about/',label:'关于',active:path.startsWith('/about')}];
---
<header class="site-header"><nav aria-label="主导航"><a href="/" class="garden-brand"><span class="brand-mark">煦</span><span>煦意<small>XUYI'S DIGITAL GARDEN</small></span></a><div class="header-right"><div class="garden-nav">{nav.map(({href,label,active})=><a href={href} data-astro-reload={path.startsWith("/games")||href.startsWith("/games")} aria-current={active?'page':undefined} class:list={{active}}>{label}</a>)}</div><button id="theme-toggle" type="button" aria-label="切换深浅主题" title="切换深浅主题"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 15a8 8 0 0 1-11-11A8.5 8.5 0 1 0 20 15Z"/></svg></button></div></nav></header>
<script>
document.addEventListener('astro:page-load',()=>{document.getElementById('theme-toggle')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}})});
document.addEventListener('astro:after-swap',()=>{try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}});
</script>
<style>
.site-header{position:relative;z-index:20;background:var(--garden-paper,#f8f7f2);border-bottom:1px solid var(--garden-line,#e3e5dc);padding:0 5vw}.site-header nav{max-width:1180px;margin:auto;height:100px;display:flex;align-items:center;justify-content:space-between;gap:20px}.garden-brand{display:flex;align-items:center;gap:13px;color:var(--garden-ink,#243c30);font-family:'Songti SC',SimSun,serif;font-size:23px;letter-spacing:3px;text-decoration:none}.brand-mark{border:1px solid #96a389;font-size:19px;line-height:1;width:38px;height:42px;display:grid;place-content:center;border-radius:18px 18px 3px 3px;color:#647b55}.garden-brand small{display:block;font:8px/1.8 Arial,sans-serif;letter-spacing:2px;color:#89917d;margin-top:4px}.header-right{display:flex;align-items:center;gap:30px}.garden-nav{display:flex;align-items:center;gap:29px}.garden-nav a{font-size:12px;color:var(--garden-muted,#858a7a);text-decoration:none;position:relative;padding:12px 0}.garden-nav a.active{color:var(--garden-ink,#243c30)}.garden-nav a.active:after{content:'';width:4px;height:4px;border-radius:50%;background:#8c9d65;position:absolute;bottom:0;left:50%;transform:translateX(-50%)}#theme-toggle{display:grid;place-content:center;padding:10px;border:1px solid var(--garden-line,#e3e5dc);border-radius:50%;color:var(--garden-muted,#858a7a);background:transparent;cursor:pointer}@media(max-width:640px){.site-header{padding:0 20px}.site-header nav{height:auto;min-height:94px;flex-wrap:wrap;gap:5px;padding:18px 0 12px}.garden-brand{font-size:19px;gap:9px}.brand-mark{width:30px;height:35px;font-size:16px}.garden-brand small{font-size:6px;letter-spacing:1.5px}.header-right{width:100%;justify-content:space-between;gap:12px;align-items:flex-start}.garden-nav{flex:1;min-width:0}.garden-nav{gap:16px;flex-wrap:wrap}.garden-nav a{font-size:11px;padding:8px 0}#theme-toggle{padding:5px;border:0}}
</style>
