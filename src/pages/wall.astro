---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`留言墙 · ${SITE_TITLE}`} description="写下你想说的话" />
		<ClientRouter />
		<style>
			main {
				max-width: 800px;
				width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 0;
			}
			.page-title {
				font-size: 1.75rem;
				margin-bottom: 0.3em;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.page-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgb(var(--gray-light)), transparent);
			}
			.page-desc {
				color: rgb(var(--gray));
				margin-bottom: 2em;
				font-size: 0.95rem;
			}
			.login-hint {
				text-align: center;
				padding: 1.5em;
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				margin-bottom: 1.5em;
			}
			.login-hint p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.login-hint a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}
			.login-hint a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<h2 class="page-title">留言墙</h2>
			<p class="page-desc">写下你想说的话，它们会留在这里。使用 GitHub 账号登录即可留言。</p>

			<div class="login-hint">
				<p>需要 <a href="https://github.com/login" target="_blank">GitHub 账号</a> 才能留言，留言会同步到项目的 Discussions 中。</p>
			</div>

			<div class="giscus"
				data-repo="Tthyq/Xuyi.blog"
				data-repo-id="R_kgDOScVCRQ"
				data-category="Announcements"
				data-category-id="DIC_kwDOScVCRc4C-fci"
				data-mapping="pathname"
				data-strict="0"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="top"
				data-theme="preferred_color_scheme"
				data-lang="zh-CN"
				data-loading="lazy"
			></div>

			<script src="https://giscus.app/client.js"
				data-repo="Tthyq/Xuyi.blog"
				data-repo-id="R_kgDOScVCRQ"
				data-category="Announcements"
				data-category-id="DIC_kwDOScVCRc4C-fci"
				data-mapping="pathname"
				data-strict="0"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="top"
				data-theme="preferred_color_scheme"
				data-lang="zh-CN"
				data-loading="lazy"
				crossorigin="anonymous"
				async>
			</script>
		</main>
		<Footer />
	</body>
</html>
