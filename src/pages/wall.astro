---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`留言墙 · ${SITE_TITLE}`} description="写下你想说的话" />
		<ClientRouter />
		<style>
			main {
				max-width: 800px;
				width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 0;
			}
			.page-title {
				font-size: 1.75rem;
				margin-bottom: 0.3em;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.page-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgb(var(--gray-light)), transparent);
			}
			.page-desc {
				color: rgb(var(--gray));
				margin-bottom: 2em;
				font-size: 0.95rem;
			}
			.giscus-wrapper {
				margin-top: 1em;
			}
			.login-hint {
				text-align: center;
				padding: 1.5em;
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				margin-bottom: 1.5em;
			}
			.login-hint p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.login-hint a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}
			.login-hint a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<h2 class="page-title">留言墙</h2>
			<p class="page-desc">写下你想说的话，它们会留在这里。使用 GitHub 账号登录即可留言。</p>

			<div class="login-hint">
				<p>需要 <a href="https://github.com/login" target="_blank">GitHub 账号</a> 才能留言，留言会同步到项目的 Discussions 中。</p>
			</div>

			<div class="giscus-wrapper">
				<giscus-widget
					repo="Tthyq/Xuyi.blog"
					repoId="R_kgDOScVCRQ"
					category="Announcements"
					categoryId="DIC_kwDOScVCRc4C-fci"
					mapping="pathname"
					strict="0"
					reactionsEnabled="1"
					emitMetadata="0"
					inputPosition="top"
					theme="preferred_color_scheme"
					lang="zh-CN"
				></giscus-widget>
			</div>
		</main>
		<Footer />

		<script>
			// Load giscus web component
			(function() {
				if (!customElements.get('giscus-widget')) {
					const s = document.createElement('script');
					s.src = 'https://unpkg.com/giscus@0.2.0/dist/giscus-widget.js';
					document.head.appendChild(s);
				}
			})();
		</script>
	</body>
</html>
