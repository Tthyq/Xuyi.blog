---
import GardenLayout from '../layouts/GardenLayout.astro';
---
<GardenLayout title="留言墙 · 煦意" description="来花园坐坐，留下一句想说的话。"><div id="top"></div><section class="page-heading"><div class="eyebrow">LEAVE A LITTLE NOTE</div><h1>来过，就留句话吧。</h1><p>可以聊聊最近在学什么，分享一个发现，或者只是说声你好。<br/>每一条认真写下的话，都值得被好好收藏。</p></section><section class="guestbook"><div class="guestbook-heading"><h2>留言墙</h2><span>GitHub Discussions</span></div><p class="reading-hint">使用 GitHub 账号登录后即可留言。原有留言仍保存在原仓库的 Discussions 中。</p><div id="giscus-container" class="giscus" aria-label="留言评论区"></div><div class="guestbook-fallback"><span id="comment-loading" role="status">正在连接留言区…</span><button id="reload-comments" type="button">重新加载</button><a href="https://github.com/Tthyq/Xuyi.blog/discussions" target="_blank" rel="noopener noreferrer">在 GitHub 查看留言 ↗</a></div></section></GardenLayout>
<script>
let cleanupWall: (()=>void)|undefined;
function initWall(){cleanupWall?.();const container=document.querySelector('#giscus-container'),retry=document.querySelector('#reload-comments'),hint=document.querySelector('#comment-loading');if(!container||!retry||!hint)return;let timer:number|undefined;const observer=new MutationObserver(()=>{const frame=container.querySelector('iframe');frame?.contentWindow?.postMessage({giscus:{setConfig:{theme:document.documentElement.dataset.theme==='dark'?'dark':'light'}}},'https://giscus.app')});const load=()=>{container.replaceChildren();hint.textContent='正在连接留言区…';const script=document.createElement('script');script.src='https://giscus.app/client.js';script.async=true;script.crossOrigin='anonymous';const config={repo:'Tthyq/Xuyi.blog','repo-id':'R_kgDOScVCRQ',category:'Announcements','category-id':'DIC_kwDOScVCRc4C-fci',mapping:'pathname',strict:'0','reactions-enabled':'1','emit-metadata':'0','input-position':'top',theme:document.documentElement.dataset.theme==='dark'?'dark':'light',lang:'zh-CN',loading:'eager'};Object.entries(config).forEach(([k,v])=>script.setAttribute('data-'+k,v));script.onerror=()=>hint.textContent='暂时无法连接评论服务，可重试或前往 GitHub 查看。';container.append(script);window.clearTimeout(timer);timer=window.setTimeout(()=>{if(!container.querySelector('iframe'))hint.textContent='连接较慢，可重新加载或在 GitHub 查看留言。'},12000)};const message=(e:MessageEvent)=>{if(e.origin!=='https://giscus.app'||e.source!==container.querySelector('iframe')?.contentWindow)return;try{const data=typeof e.data==='string'?JSON.parse(e.data):e.data;if(data?.giscus?.resizeHeight){hint.textContent='留言区已连接 · 使用 GitHub 账号登录即可留言。'}}catch{}};window.addEventListener('message',message);observer.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});retry.addEventListener('click',load);load();cleanupWall=()=>{window.clearTimeout(timer);window.removeEventListener('message',message);retry.removeEventListener('click',load);observer.disconnect()}}
document.addEventListener('astro:page-load',initWall);document.addEventListener('astro:before-swap',()=>cleanupWall?.());
</script>
<style>.guestbook{max-width:850px;margin:35px auto;padding:30px;background:var(--garden-card);border:1px solid var(--garden-line);border-radius:5px}.guestbook-heading{display:flex;justify-content:space-between;align-items:center;gap:15px}.guestbook-heading h2{font-size:24px;margin:0}.guestbook-heading span{font:9px Arial;color:var(--garden-muted);letter-spacing:1px}.giscus{min-height:200px}.guestbook-fallback{display:flex;flex-wrap:wrap;align-items:center;gap:15px;color:var(--garden-muted);font-size:10px;border-top:1px solid var(--garden-line);padding-top:18px;margin-top:20px}.guestbook-fallback button{background:none;border:0;color:var(--garden-accent);font-size:10px;cursor:pointer}.guestbook-fallback a{margin-left:auto;color:var(--garden-muted)}@media(max-width:640px){.guestbook{padding:20px}.guestbook-fallback a{margin-left:0}.guestbook-heading span{font-size:8px}}
</style>
