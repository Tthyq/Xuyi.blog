---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`留言墙 · ${SITE_TITLE}`} description="写下你想说的话" />
		<ClientRouter />
		<style>
			main {
				max-width: 800px;
				width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2.5em 0 3em 0;
			}
			.page-header {
				margin-bottom: 2.5em;
			}
			.page-title {
				font-size: 1.75rem;
				margin: 0 0 0.5em 0;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.page-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgb(var(--gray-light)), transparent);
			}
			.page-desc {
				color: rgb(var(--gray));
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.6;
			}
			.login-hint {
				display: flex;
				align-items: center;
				gap: 0.6em;
				padding: 1em 1.2em;
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 10px;
				margin-bottom: 2em;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.login-hint svg {
				flex-shrink: 0;
				color: var(--accent);
			}
			.login-hint a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}
			.login-hint a:hover {
				text-decoration: underline;
			}
			.giscus-section {
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 16px;
				padding: 1.5em;
				min-height: 300px;
			}
			.giscus-section :global(iframe) {
				border-radius: 8px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<div class="page-header">
				<h2 class="page-title">留言墙</h2>
				<p class="page-desc">写下你想说的话，它们会留在这里</p>
			</div>

			<div class="login-hint">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
				</svg>
				<span>使用 <a href="https://github.com/login" target="_blank">GitHub 账号</a> 登录后即可留言</span>
			</div>

			<div class="giscus-section">
				<div class="giscus"
					data-repo="Tthyq/Xuyi.blog"
					data-repo-id="R_kgDOScVCRQ"
					data-category="Announcements"
					data-category-id="DIC_kwDOScVCRc4C-fci"
					data-mapping="pathname"
					data-strict="0"
					data-reactions-enabled="1"
					data-emit-metadata="0"
					data-input-position="top"
					data-theme="preferred_color_scheme"
					data-lang="zh-CN"
					data-loading="lazy"
				></div>

				<script src="https://giscus.app/client.js"
					data-repo="Tthyq/Xuyi.blog"
					data-repo-id="R_kgDOScVCRQ"
					data-category="Announcements"
					data-category-id="DIC_kwDOScVCRc4C-fci"
					data-mapping="pathname"
					data-strict="0"
					data-reactions-enabled="1"
					data-emit-metadata="0"
					data-input-position="top"
					data-theme="preferred_color_scheme"
					data-lang="zh-CN"
					data-loading="lazy"
					crossorigin="anonymous"
					async>
				</script>
			</div>
		</main>
		<Footer />
	</body>
</html>
