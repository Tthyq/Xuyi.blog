---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 2em 0 1em 0;
			}
			.hero h1 {
				font-size: 3.5rem;
				margin: 0 0 0.2em 0;
				letter-spacing: -0.02em;
			}
			.hero .subtitle {
				font-size: 1.15rem;
				color: rgb(var(--gray));
				max-width: 480px;
				margin: 0 auto 1.5em auto;
				line-height: 1.6;
			}
			.hero-links {
				display: flex;
				gap: 1em;
				justify-content: center;
				flex-wrap: wrap;
			}
			.hero-links a {
				padding: 0.6em 1.5em;
				border-radius: 8px;
				font-weight: 600;
				font-size: 0.95rem;
				transition: all 0.2s ease;
			}
			.btn-primary {
				background: var(--accent);
				color: #fff !important;
			}
			.btn-primary:hover {
				background: var(--accent-dark);
				box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
			}
			.btn-secondary {
				background: rgba(37, 99, 235, 0.06);
				color: var(--accent) !important;
			}
			.btn-secondary:hover {
				background: rgba(37, 99, 235, 0.12);
			}
			.section-title {
				font-size: 1.25rem;
				margin: 2.5em 0 1em 0;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.section-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgb(var(--gray-light)), transparent);
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				padding: 0.8em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list li:last-child {
				border-bottom: none;
			}
			.post-list a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				text-decoration: none;
				color: rgb(var(--black));
				transition: color 0.2s ease;
			}
			.post-list a:hover {
				color: var(--accent);
			}
			.post-list .post-title {
				font-weight: 500;
			}
			.post-list .post-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.tag-badge {
				display: inline-block;
				font-size: 0.7rem;
				padding: 0.1em 0.5em;
				border-radius: 3px;
				background: rgba(37, 99, 235, 0.08);
				color: var(--accent);
				margin-left: 0.6em;
				vertical-align: middle;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1><span class="gradient-text">XuYi</span></h1>
				<p class="subtitle">{SITE_DESCRIPTION}</p>
				<div class="hero-links">
					<a href="/blog" class="btn-primary">浏览博客</a>
					<a href="/about" class="btn-secondary">关于我</a>
				</div>
			</section>

			<section>
				<h2 class="section-title">最近更新</h2>
				<ul class="post-list">
					{
						posts.slice(0, 5).map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">
										{post.data.title}
										{post.data.tags.length > 0 && (
											<span class="tag-badge">{post.data.tags[0]}</span>
										)}
									</span>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
