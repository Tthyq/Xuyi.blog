---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { ClientRouter } from 'astro:transitions';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<ClientRouter />
		<style>
			.hero {
				text-align: center;
				padding: 2em 0 1em 0;
			}
			.hero h1 {
				font-size: 3.5rem;
				margin: 0 0 0.2em 0;
				letter-spacing: -0.02em;
			}
			.hero .subtitle {
				font-size: 1.15rem;
				color: rgb(var(--gray));
				max-width: 480px;
				margin: 0 auto 1.5em auto;
				line-height: 1.6;
			}
			.portal-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.2em;
				margin: 1.5em 0 2.5em 0;
			}
			.portal-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 1.8em 1.2em;
				border-radius: 16px;
				text-decoration: none;
				transition: all 0.3s ease;
				border: 1px solid transparent;
			}
			.portal-card:hover {
				transform: translateY(-4px);
			}
			.card-blog {
				background: linear-gradient(135deg, rgba(37,99,235,0.06), rgba(6,182,212,0.06));
				border-color: rgba(37,99,235,0.12);
				color: var(--accent);
			}
			.card-blog:hover {
				box-shadow: 0 8px 32px rgba(37,99,235,0.12);
			}
			.card-ai {
				background: linear-gradient(135deg, rgba(139,92,246,0.06), rgba(6,182,212,0.06));
				border-color: rgba(139,92,246,0.12);
				color: var(--accent-purple, #8b5cf6);
			}
			.card-ai:hover {
				box-shadow: 0 8px 32px rgba(139,92,246,0.12);
			}
			.card-games {
				background: linear-gradient(135deg, rgba(251,146,60,0.06), rgba(239,68,68,0.06));
				border-color: rgba(251,146,60,0.12);
				color: #f59e0b;
			}
			.card-games:hover {
				box-shadow: 0 8px 32px rgba(251,146,60,0.12);
			}
			[data-theme="dark"] .card-blog {
				background: linear-gradient(135deg, rgba(37,99,235,0.15), rgba(6,182,212,0.15));
				border-color: rgba(96,165,250,0.2);
			}
			[data-theme="dark"] .card-ai {
				background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(6,182,212,0.15));
				border-color: rgba(167,139,250,0.2);
			}
			[data-theme="dark"] .card-games {
				background: linear-gradient(135deg, rgba(251,146,60,0.15), rgba(239,68,68,0.15));
				border-color: rgba(251,146,60,0.2);
			}
			.portal-card-icon {
				width: 40px;
				height: 40px;
				margin-bottom: 0.6em;
			}
			.portal-card h3 {
				font-size: 1.15rem;
				margin: 0 0 0.3em 0;
			}
			.portal-card p {
				font-size: 0.85rem;
				margin: 0;
				color: rgb(var(--gray));
				line-height: 1.5;
			}
			.section-title {
				font-size: 1.25rem;
				margin: 2.5em 0 1em 0;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.section-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgb(var(--gray-light)), transparent);
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				padding: 0.8em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list li:last-child { border-bottom: none; }
			.post-list a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				text-decoration: none;
				color: rgb(var(--black));
				transition: color 0.2s ease;
			}
			.post-list a:hover { color: var(--accent); }
			.post-list .post-title { font-weight: 500; }
			.post-list .post-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.tag-badge {
				display: inline-block;
				font-size: 0.7rem;
				padding: 0.1em 0.5em;
				border-radius: 3px;
				background: rgba(37,99,235,0.08);
				color: var(--accent);
				margin-left: 0.6em;
				vertical-align: middle;
			}
			[data-theme="dark"] .tag-badge {
				background: rgba(96,165,250,0.15);
			}
			@media (max-width: 720px) {
				.portal-grid {
					grid-template-columns: 1fr;
					gap: 0.8em;
				}
				.portal-card { padding: 1.2em; }
			}
		</style>
	</head>
	<body>
		<ParticleBackground />
		<Header />
		<main transition:animate="fade">
			<section class="hero">
				<h1><span class="gradient-text">XuYi</span></h1>
				<p class="subtitle">{SITE_DESCRIPTION}</p>
			</section>

			<section class="portal-grid">
				<a href="/blog" class="portal-card card-blog">
					<svg class="portal-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
						<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
						<path d="M8 7h8"/>
						<path d="M8 11h6"/>
					</svg>
					<h3>阅读专栏</h3>
					<p>随笔、音乐与科技的思考记录</p>
				</a>
				<a href="/ai" class="portal-card card-ai">
					<svg class="portal-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 2a4 4 0 0 1 4 4c0 2-2 3-2 3h-4s-2-1-2-3a4 4 0 0 1 4-4z"/>
						<path d="M8 15h8"/>
						<path d="M8 19h8"/>
						<path d="M12 11v4"/>
						<circle cx="16" cy="16" r="1"/>
						<circle cx="8" cy="16" r="1"/>
					</svg>
					<h3>AI 实验室</h3>
					<p>多模型对话与 AI 能力试验场</p>
				</a>
				<a href="/games" class="portal-card card-games">
					<svg class="portal-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="6" y1="12" x2="10" y2="12"/>
						<line x1="8" y1="10" x2="8" y2="14"/>
						<line x1="15" y1="13" x2="15.01" y2="13"/>
						<line x1="18" y1="11" x2="18.01" y2="11"/>
						<rect x="2" y="6" width="20" height="12" rx="2"/>
					</svg>
					<h3>游乐场</h3>
					<p>浏览器里的小游戏与交互玩具</p>
				</a>
			</section>

			<section>
				<h2 class="section-title">最近更新</h2>
				<ul class="post-list">
					{posts.slice(0, 5).map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">
									{post.data.title}
									{post.data.tags.length > 0 && (
										<span class="tag-badge">{post.data.tags[0]}</span>
									)}
								</span>
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
		<script src="../scripts/scroll-animations.js"></script>
	</body>
</html>
