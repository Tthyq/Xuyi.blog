---
import GardenLayout from '../../../layouts/GardenLayout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const years=[...new Set(posts.map(p=>p.data.pubDate.getUTCFullYear()))];
const tags=[...new Set(posts.flatMap(p=>p.data.tags))].filter(t=>!['煦意熙焉','煦意'].includes(t));
---
<GardenLayout title="往日手记 · 煦意" description="关于成长、选择、音乐与生活的旧文专栏。"><div id="top"></div><section class="page-heading"><a href="/" class="back-link">← 回到花园</a><div class="eyebrow">THE WRITING ARCHIVE / COLLECTION 01</div><h1>往日手记</h1><p>曾经写下的思考、听过的歌，和那些值得记住的瞬间。<br/>把 {posts.length} 篇旧文完整收在这里。没有丢掉，只是换了一个安静的位置。</p></section><div class="archive-toolbar"><label class="archive-search"><span>⌕</span><input id="archive-search" type="search" aria-label="搜索文章" placeholder="搜索标题、摘要、标签…"/></label><select id="archive-tag" class="archive-filter" aria-label="按标签筛选"><option value="">全部主题</option>{tags.map(t=><option value={t}>{t}</option>)}</select><span id="archive-results" class="archive-results" aria-live="polite">共 {posts.length} 篇文字</span></div><div id="archive-posts">{years.map(year=><section class="year-group"><h2>{year}</h2><ul class="archive-list">{posts.filter(p=>p.data.pubDate.getUTCFullYear()===year).map(post=><li class="archive-post" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()} data-tags={JSON.stringify(post.data.tags)}><a href={`/blog/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(5,10).replace('-',' / ')}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="post-tags">{post.data.tags.filter(t=>!['煦意熙焉','煦意'].includes(t)).map(tag=><span>{tag}</span>)}</div></div><span class="post-arrow">↗</span></a></li>)}</ul></section>)}</div><p id="archive-empty" class="archive-empty" hidden>没有找到对应的文章。试试换一个关键词。</p><p class="archive-ending">文字留在这里，日子继续向前。</p></GardenLayout>
<script>
function initArchive(){const input=document.querySelector<HTMLInputElement>('#archive-search'),select=document.querySelector<HTMLSelectElement>('#archive-tag');if(!input||!select)return;const update=()=>{const q=input.value.trim().toLowerCase(),tag=select.value;let count=0;document.querySelectorAll<HTMLElement>('.archive-post').forEach(post=>{const tags: string[]=JSON.parse(post.dataset.tags||'[]');post.hidden=!((post.dataset.search||'').includes(q)&&(!tag||tags.includes(tag)));if(!post.hidden)count++});document.querySelectorAll<HTMLElement>('.year-group').forEach(group=>group.hidden=!group.querySelector('.archive-post:not([hidden])'));const results=document.querySelector('#archive-results'),empty=document.querySelector<HTMLElement>('#archive-empty');if(results)results.textContent=`共 ${count} 篇文字`;if(empty)empty.hidden=count>0};input.addEventListener('input',update);select.addEventListener('change',update)}
document.addEventListener('astro:page-load',initArchive);
</script>
