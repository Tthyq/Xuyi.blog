---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.page-title {
				font-size: 1.75rem;
				margin-bottom: 1.5em;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.page-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgb(var(--gray-light)), transparent);
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				background: rgba(255, 255, 255, 0.6);
				border-radius: 16px;
				padding: 1.2em;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				border: 1px solid rgba(37, 99, 235, 0.06);
			}
			ul li:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(37, 99, 235, 0.08);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 0;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.date {
				margin: 0.3em 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.tags {
				margin-top: 0.5rem;
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			.tag {
				background: rgba(37, 99, 235, 0.08);
				color: var(--accent);
				padding: 0.15rem 0.6rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: 500;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
					padding: 1em;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h2 class="page-title">博客</h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{
										post.data.tags.length > 0 && (
											<div class="tags">
												{post.data.tags.map(tag => <span class="tag">{tag}</span>)}
											</div>
										)
									}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
