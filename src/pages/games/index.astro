---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={'游乐场 · ' + SITE_TITLE} description="浏览器小游戏与交互玩具" />
		<style>
			.game-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 1.2em;
				margin-top: 1.5em;
			}
			.game-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 2em 1.2em;
				border-radius: 16px;
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				text-decoration: none;
				transition: all 0.3s ease;
				cursor: pointer;
				min-height: 160px;
			}
			.game-card:hover {
				transform: translateY(-4px);
				border-color: var(--accent);
				box-shadow: 0 8px 24px rgba(37,99,235,0.08);
			}
			.game-icon {
				width: 48px;
				height: 48px;
				margin-bottom: 0.8em;
				color: var(--text-secondary);
			}
			.game-card h3 {
				font-size: 1.1rem;
				margin: 0 0 0.3em 0;
				color: var(--text-primary);
			}
			.game-card p {
				font-size: 0.8rem;
				margin: 0;
				color: var(--text-secondary);
				line-height: 1.4;
			}
			.game-status {
				margin-top: 0.6em;
				font-size: 0.7rem;
				padding: 0.2em 0.6em;
				border-radius: 4px;
				background: rgba(34,197,94,0.1);
				color: #16a34a;
				font-weight: 500;
			}
			@media (max-width: 720px) {
				.game-grid {
					grid-template-columns: repeat(2, 1fr);
					gap: 0.8em;
				}
				.game-card { padding: 1.2em 0.8em; min-height: 130px; }
			}
		</style>
	</head>
	<body>
		<ParticleBackground />
		<Header />
		<main>
			<h2 style="margin:0 0 0.3em 0;font-size:1.5rem;">游乐场</h2>
			<p style="margin:0 0 0.5em 0;color:var(--text-secondary);font-size:0.9rem;">
				选择游戏开始玩耍
			</p>
			<div class="game-grid">
				<a href="/games/snake" class="game-card">
					<svg class="game-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 2a4 4 0 0 1 4 4c0 2-2 3-2 3h-4s-2-1-2-3a4 4 0 0 1 4-4z"/>
						<path d="M8 15h8"/><path d="M8 19h8"/><path d="M12 11v4"/>
					</svg>
					<h3>贪吃蛇</h3>
					<p>经典街机游戏，键盘方向键控制</p>
					<span class="game-status">可玩</span>
				</a>
				<a href="/games/tetris" class="game-card">
					<svg class="game-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
						<rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
					</svg>
					<h3>俄罗斯方块</h3>
					<p>经典下落式方块拼图</p>
					<span class="game-status">可玩</span>
				</a>
				<a href="/games/minesweeper" class="game-card">
					<svg class="game-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/>
						<line x1="8" y1="12" x2="16" y2="12"/>
					</svg>
					<h3>扫雷</h3>
					<p>推理与运气的经典博弈</p>
					<span class="game-status">可玩</span>
				</a>
				<a href="/games/2048" class="game-card">
					<svg class="game-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/>
						<rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/>
					</svg>
					<h3>2048</h3>
					<p>滑动合并数字的益智游戏</p>
					<span class="game-status">可玩</span>
				</a>
				<a href="/games/memory" class="game-card">
					<svg class="game-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="3" width="20" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/>
						<line x1="2" y1="12" x2="22" y2="12"/>
					</svg>
					<h3>翻牌配对</h3>
					<p>考验记忆力的翻牌游戏</p>
					<span class="game-status">可玩</span>
				</a>
				<a href="/games/reaction" class="game-card">
					<svg class="game-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
					</svg>
					<h3>反应测试</h3>
					<p>测试你的反应速度</p>
					<span class="game-status">可玩</span>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
