---
import GardenLayout from '../../layouts/GardenLayout.astro';
import {games} from '../../data/games';
---
<GardenLayout title="游乐场 · 煦意" description="18款浏览器小游戏，学习间隙，放空一小会儿。"><div id="top"></div><section class="page-heading"><div class="eyebrow">A LITTLE BREAK / PLAYGROUND</div><h1>偷一点闲，<br/>给大脑松松土。</h1><p>18 个小玩具，不用下载，点开就能玩。<br/>学累了就来转一圈，轻轻松松地赢一局。</p></section><div class="play-filters" role="group" aria-label="按类型筛选">{['全部','益智','街机','棋盘','专注'].map((c,i)=><button data-game-filter={c} class:list={{active:i===0}}>{c}</button>)}<span id="game-count">18 款游戏</span></div><div class="play-grid">{games.map((g,i)=><a data-astro-reload href={`/games/${g.id}/`} class="play-card" data-category={g.category}><div class="play-card-art" data-variant={i%4}><span class="play-card-index">PLAY {String(i+1).padStart(2,'0')}</span><span class="play-mark">{g.mark}</span><span class="play-art-grid"></span></div><div class="play-card-copy"><div class="play-category">{g.category}{!g.legacy&&<span>新加入</span>}</div><h2>{g.name}<span>↗</span></h2><p>{g.description}</p></div></a>)}</div><p class="reading-hint">小游戏在浏览器内运行。需要方向键的游戏，建议使用键盘；新增游戏也提供触屏操作。<br/>小憩之后，记得回来继续种你的花园。</p></GardenLayout>
<script>
document.addEventListener('astro:page-load',()=>{const buttons=document.querySelectorAll<HTMLButtonElement>('[data-game-filter]');buttons.forEach(b=>b.onclick=()=>{buttons.forEach(x=>x.classList.toggle('active',x===b));let n=0;document.querySelectorAll<HTMLElement>('.play-card').forEach(c=>{c.hidden=b.dataset.gameFilter!=='全部'&&c.dataset.category!==b.dataset.gameFilter;if(!c.hidden)n++});const label=document.querySelector('#game-count');if(label)label.textContent=n+' 款游戏'})});
</script>
<style>.play-filters{display:flex;align-items:center;gap:9px;margin:30px 0 25px;flex-wrap:wrap}.play-filters button{font:11px sans-serif;border:1px solid var(--garden-line);background:transparent;color:var(--garden-muted);border-radius:3px;padding:8px 17px;cursor:pointer}.play-filters button.active{background:#304c38;color:#f6f7ef;border-color:#304c38}.play-filters>span{margin-left:auto;font-size:10px;color:var(--garden-muted)}.play-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.play-card{border:1px solid var(--garden-line);background:var(--garden-card);text-decoration:none;border-radius:5px;overflow:hidden;transition:transform .2s}.play-card:hover{transform:translateY(-4px)}.play-card-art{height:135px;position:relative;background:#e8eddc;overflow:hidden;display:grid;place-content:center}.play-card-art[data-variant="1"]{background:#eee9dd}.play-card-art[data-variant="2"]{background:#dfe9e4}.play-card-art[data-variant="3"]{background:#e7e5ed}.play-card-index{position:absolute;left:17px;top:13px;font:8px Arial;letter-spacing:2px;color:#929c84}.play-mark{font:42px Georgia,serif;color:#788d64;border:1px solid #acb99b;border-radius:12px;padding:6px 18px;transform:rotate(-7deg);z-index:1}.play-art-grid{position:absolute;inset:0;background-image:linear-gradient(#8b9c6912 1px,transparent 1px),linear-gradient(90deg,#8b9c6912 1px,transparent 1px);background-size:25px 25px}.play-card-copy{padding:20px 23px}.play-category{font-size:9px;color:var(--garden-muted);display:flex;justify-content:space-between}.play-category>span{font-size:8px;color:#839b62;background:var(--garden-tint);padding:1px 6px}.play-card h2{font-size:20px;margin:10px 0;display:flex;justify-content:space-between}.play-card h2 span{font-size:16px;color:#93a17f}.play-card p{font-size:10px;color:var(--garden-muted);line-height:1.9}@media(max-width:900px){.play-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.play-grid{gap:12px}.play-card-art{height:102px}.play-mark{font-size:30px;padding:3px 12px}.play-card-copy{padding:14px}.play-card h2{font-size:18px}.play-card p{font-size:9px}.play-card-index{font-size:7px;left:10px}.play-filters button{padding:7px 11px;font-size:10px}.play-filters{gap:6px}.play-filters>span{font-size:9px}}
</style>
