---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
import { SITE_TITLE } from '../../consts';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={'反应测试 · ' + SITE_TITLE} description="测试你的反应速度" />
		<ClientRouter />
		<style>
			.game-wrapper { display: flex; flex-direction: column; align-items: center; gap: 1.5em; }
			.test-area { width: 100%; max-width: 500px; min-height: 300px; border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; user-select: none; transition: all 0.3s; padding: 2em; text-align: center; }
			.state-idle { background: var(--bg-card); border: 2px dashed var(--border-color); }
			.state-waiting { background: rgba(239,68,68,0.15); border: 2px solid rgba(239,68,68,0.3); }
			.state-ready { background: rgba(34,197,94,0.15); border: 2px solid rgba(34,197,94,0.3); }
			.state-result { background: var(--bg-card); border: 2px solid var(--border-color); }
			.state-tooearly { background: rgba(251,146,60,0.15); border: 2px solid rgba(251,146,60,0.3); }
			.test-area h2 { margin: 0 0 0.3em 0; font-size: 1.8rem; }
			.test-area p { margin: 0; font-size: 1rem; color: rgb(var(--gray)); }
			.test-area .big-number { font-size: 4rem; font-weight: 800; color: var(--accent); margin: 0.2em 0; }
			.test-area .rating { font-size: 1.2rem; margin-top: 0.5em; }
			.history { width: 100%; max-width: 500px; }
			.history h3 { margin: 0 0 0.8em 0; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5em; }
			.history h3::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, rgb(var(--gray-light)), transparent); }
			.history-list { display: flex; flex-wrap: wrap; gap: 0.5em; }
			.history-item { padding: 0.4em 0.8em; border-radius: 6px; font-size: 0.85rem; font-weight: 600; }
			.history-fast { background: rgba(34,197,94,0.1); color: #16a34a; }
			.history-normal { background: rgba(37,99,235,0.08); color: var(--accent); }
			.history-slow { background: rgba(251,146,60,0.1); color: #ea580c; }
			.best-score { margin-top: 1em; font-size: 0.9rem; color: rgb(var(--gray)); }
			.best-score span { color: var(--accent); font-weight: 700; }
			.controls-hint { font-size: 0.8rem; color: rgb(var(--gray)); text-align: center; }
		</style>
	</head>
	<body>
		<ParticleBackground />
		<Header />
		<main>
			<div class="game-wrapper">
				<h2 style="margin:0;font-size:1.5rem;">反应速度测试</h2>
				<div class="test-area state-idle" id="testArea">
					<h2 id="areaTitle">点击开始测试</h2>
					<p id="areaDesc">测试你的反应速度有多快</p>
				</div>
				<div class="history">
					<h3>历史记录</h3>
					<div class="history-list" id="historyList"></div>
					<div class="best-score">最佳成绩: <span id="bestScore">--</span> ms</div>
				</div>
				<div class="controls-hint">点击方块或按任意键开始</div>
			</div>
		</main>
		<Footer />

		<script>
			(function() {
				const testArea = document.getElementById('testArea');
				const areaTitle = document.getElementById('areaTitle');
				const areaDesc = document.getElementById('areaDesc');
				const historyList = document.getElementById('historyList');
				const bestScoreEl = document.getElementById('bestScore');

				const STORAGE_KEY = 'reaction_history';
				let state = 'idle'; // idle, waiting, ready, result, tooearly
				let startTime = 0;
				let timeout = null;

				function getHistory() {
					try {
						return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
					} catch {
						return [];
					}
				}

				function saveHistory(h) {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(h));
				}

				function renderHistory() {
					const history = getHistory();
					if (history.length === 0) {
						historyList.innerHTML = '<span style="color:rgb(var(--gray));font-size:0.85rem;">暂无记录</span>';
						bestScoreEl.textContent = '--';
						return;
					}

					const best = Math.min(...history);
					bestScoreEl.textContent = best;

					historyList.innerHTML = history.slice(-10).reverse().map(ms => {
						const cls = ms < 250 ? 'history-fast' : ms < 400 ? 'history-normal' : 'history-slow';
						return `<span class="history-item ${cls}">${ms}ms</span>`;
					}).join('');
				}

				function getRating(ms) {
					if (ms < 200) return { text: '闪电反应!', color: '#22c55e' };
					if (ms < 250) return { text: '非常快', color: '#22c55e' };
					if (ms < 350) return { text: '不错', color: 'var(--accent)' };
					if (ms < 500) return { text: '一般般', color: '#ea580c' };
					return { text: '还需练习', color: '#ef4444' };
				}

				function setState(s) {
					state = s;
					testArea.className = `test-area state-${s}`;
				}

				function startTest() {
					if (state === 'waiting' || state === 'ready') return;

					setState('waiting');
					areaTitle.textContent = '等待...';
					areaDesc.textContent = '当背景变绿时立即点击';

					const delay = 1000 + Math.random() * 4000;
					timeout = setTimeout(() => {
						setState('ready');
						areaTitle.textContent = '点击!';
						areaDesc.textContent = '现在!';
						startTime = performance.now();
					}, delay);
				}

				function handleClick() {
					if (state === 'idle' || state === 'result' || state === 'tooearly') {
						startTest();
						return;
					}

					if (state === 'waiting') {
						clearTimeout(timeout);
						setState('tooearly');
						areaTitle.textContent = '太早了!';
						areaDesc.textContent = '点击重新开始';
						return;
					}

					if (state === 'ready') {
						const ms = Math.round(performance.now() - startTime);
						const rating = getRating(ms);

						setState('result');
						areaTitle.innerHTML = `<div class="big-number">${ms}</div>毫秒`;
						areaDesc.innerHTML = `<div class="rating" style="color:${rating.color}">${rating.text}</div><p style="margin-top:0.5em">点击重新开始</p>`;

						const history = getHistory();
						history.push(ms);
						if (history.length > 20) history.shift();
						saveHistory(history);
						renderHistory();
					}
				}

				testArea.addEventListener('click', handleClick);
				document.addEventListener('keydown', (e) => {
					if (e.key === ' ' || e.key === 'Enter') {
						e.preventDefault();
						handleClick();
					}
				});

				renderHistory();
			})();
		</script>
	</body>
</html>
