---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={'2048 · ' + SITE_TITLE} description="经典 2048 数字游戏" />
		<style>
			.game-wrapper { display: flex; flex-direction: column; align-items: center; gap: 1.5em; }
			.game-header { display: flex; justify-content: space-between; align-items: center; width: 100%; max-width: 400px; }
			.score-box { text-align: center; padding: 0.4em 1em; background: rgba(37,99,235,0.08); border-radius: 8px; }
			.score-box .label { font-size: 0.75rem; color: rgb(var(--gray)); text-transform: uppercase; }
			.score-box .value { font-size: 1.4rem; font-weight: 700; color: var(--accent); }
			.scores { display: flex; gap: 0.8em; }
			.game-btn { padding: 0.5em 1.2em; border-radius: 8px; border: none; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: inherit; }
			.btn-new { background: var(--accent); color: #fff; }
			.btn-new:hover { background: var(--accent-dark); }
			.board-container { position: relative; }
			.board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 10px; background: #bbada0; border-radius: 12px; width: 370px; height: 370px; box-sizing: border-box; }
			[data-theme="dark"] .board { background: #1a1a2e; }
			.cell { border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.8rem; user-select: none; min-height: 78px; border: 1px solid rgba(0,0,0,0.1); }
			.cell-0 { background: rgba(238,228,218,0.35); color: transparent; }
			.cell-2 { background: #eee4da; color: #776e65; }
			.cell-4 { background: #ede0c8; color: #776e65; }
			.cell-8 { background: #f2b179; color: #f9f6f2; }
			.cell-16 { background: #f59563; color: #f9f6f2; }
			.cell-32 { background: #f67c5f; color: #f9f6f2; }
			.cell-64 { background: #f65e3b; color: #f9f6f2; }
			.cell-128 { background: #edcf72; color: #f9f6f2; font-size: 1.5rem; }
			.cell-256 { background: #edcc61; color: #f9f6f2; font-size: 1.5rem; }
			.cell-512 { background: #edc850; color: #f9f6f2; font-size: 1.5rem; }
			.cell-1024 { background: #edc53f; color: #f9f6f2; font-size: 1.2rem; }
			.cell-2048 { background: #edc22e; color: #f9f6f2; font-size: 1.2rem; }
			.cell-super { background: #3c3a32; color: #f9f6f2; font-size: 1rem; }
			[data-theme="dark"] .cell-0 { background: rgba(255,255,255,0.05); }
			[data-theme="dark"] .cell-2 { background: #3d3a5c; color: #e8e8e8; }
			[data-theme="dark"] .cell-4 { background: #4a4570; color: #e8e8e8; }
			[data-theme="dark"] .cell-8 { background: #5a4f80; color: #f9f6f2; }
			[data-theme="dark"] .cell-16 { background: #6b5a90; color: #f9f6f2; }
			[data-theme="dark"] .cell-32 { background: #7c65a0; color: #f9f6f2; }
			[data-theme="dark"] .cell-64 { background: #8d70b0; color: #f9f6f2; }
			[data-theme="dark"] .cell-128 { background: #9e7bc0; color: #f9f6f2; }
			[data-theme="dark"] .cell-256 { background: #af86d0; color: #f9f6f2; }
			[data-theme="dark"] .cell-512 { background: #c091e0; color: #f9f6f2; }
			[data-theme="dark"] .cell-1024 { background: #d19cf0; color: #f9f6f2; }
			[data-theme="dark"] .cell-2048 { background: #e2a7ff; color: #f9f6f2; }
			[data-theme="dark"] .cell-super { background: #5c3a8a; color: #f9f6f2; }
			.game-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(15,23,42,0.85); border-radius: 12px; color: #fff; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
			.game-overlay.show { opacity: 1; pointer-events: auto; }
			.game-overlay h2 { color: #fff; font-size: 2rem; margin: 0 0 0.3em 0; }
			.game-overlay p { margin: 0 0 1em 0; font-size: 1rem; opacity: 0.7; }
			.controls-hint { font-size: 0.8rem; color: rgb(var(--gray)); text-align: center; margin-top: 0.5em; }
			.controls-hint kbd { padding: 0.15em 0.4em; border-radius: 4px; background: rgb(var(--gray-light)); font-size: 0.8rem; font-family: inherit; }
			@media (max-width: 720px) {
				.board { width: 300px; height: 300px; }
				.cell { font-size: 1.4rem; min-height: 64px; }
				.cell-128, .cell-256, .cell-512 { font-size: 1.1rem; }
				.cell-1024, .cell-2048 { font-size: 0.9rem; }
				.cell-super { font-size: 0.8rem; }
			}
		</style>
	</head>
	<body>
		<ParticleBackground />
		<Header />
		<main>
			<div class="game-wrapper">
				<h2 style="margin:0;font-size:1.5rem;">2048</h2>
				<div class="game-header">
					<div class="scores">
						<div class="score-box">
							<div class="label">得分</div>
							<div class="value" id="score">0</div>
						</div>
						<div class="score-box">
							<div class="label">最高分</div>
							<div class="value" id="highScore">0</div>
						</div>
					</div>
					<button class="game-btn btn-new" id="newBtn">新游戏</button>
				</div>
				<div class="board-container">
					<div class="board" id="board"></div>
					<div class="game-overlay" id="overlay">
						<h2 id="overlayTitle">游戏结束</h2>
						<p id="overlayMsg"></p>
						<button class="game-btn btn-new" id="restartBtn">再来一局</button>
					</div>
				</div>
				<div class="controls-hint">
					使用 <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> 或方向键滑动方块
				</div>
			</div>
		</main>
		<Footer />

		<script>
			(function() {
				const boardEl = document.getElementById('board');
				const scoreEl = document.getElementById('score');
				const highScoreEl = document.getElementById('highScore');
				const overlay = document.getElementById('overlay');
				const overlayTitle = document.getElementById('overlayTitle');
				const overlayMsg = document.getElementById('overlayMsg');
				const newBtn = document.getElementById('newBtn');
				const restartBtn = document.getElementById('restartBtn');

				let grid, score, highScore, won;

				highScore = parseInt(localStorage.getItem('2048_high') || '0');
				highScoreEl.textContent = highScore;

				function init() {
					grid = Array.from({length: 4}, () => Array(4).fill(0));
					score = 0;
					won = false;
					scoreEl.textContent = '0';
					overlay.classList.remove('show');
					addRandom();
					addRandom();
					render();
				}

				function addRandom() {
					const empty = [];
					for (let r = 0; r < 4; r++)
						for (let c = 0; c < 4; c++)
							if (grid[r][c] === 0) empty.push([r, c]);
					if (empty.length === 0) return;
					const [r, c] = empty[Math.floor(Math.random() * empty.length)];
					grid[r][c] = Math.random() < 0.9 ? 2 : 4;
				}

				const lightStyles = {
					0:    { bg: 'rgba(238,228,218,0.35)', color: 'transparent' },
					2:    { bg: '#eee4da', color: '#776e65' },
					4:    { bg: '#ede0c8', color: '#776e65' },
					8:    { bg: '#f2b179', color: '#f9f6f2' },
					16:   { bg: '#f59563', color: '#f9f6f2' },
					32:   { bg: '#f67c5f', color: '#f9f6f2' },
					64:   { bg: '#f65e3b', color: '#f9f6f2' },
					128:  { bg: '#edcf72', color: '#f9f6f2' },
					256:  { bg: '#edcc61', color: '#f9f6f2' },
					512:  { bg: '#edc850', color: '#f9f6f2' },
					1024: { bg: '#edc53f', color: '#f9f6f2' },
					2048: { bg: '#edc22e', color: '#f9f6f2' },
				};
				const darkStyles = {
					0:    { bg: 'rgba(255,255,255,0.05)', color: 'transparent' },
					2:    { bg: '#3d3a5c', color: '#e8e8e8' },
					4:    { bg: '#4a4570', color: '#e8e8e8' },
					8:    { bg: '#5a4f80', color: '#f9f6f2' },
					16:   { bg: '#6b5a90', color: '#f9f6f2' },
					32:   { bg: '#7c65a0', color: '#f9f6f2' },
					64:   { bg: '#8d70b0', color: '#f9f6f2' },
					128:  { bg: '#9e7bc0', color: '#f9f6f2' },
					256:  { bg: '#af86d0', color: '#f9f6f2' },
					512:  { bg: '#c091e0', color: '#f9f6f2' },
					1024: { bg: '#d19cf0', color: '#f9f6f2' },
					2048: { bg: '#e2a7ff', color: '#f9f6f2' },
				};
				const superLight = { bg: '#3c3a32', color: '#f9f6f2' };
				const superDark = { bg: '#5c3a8a', color: '#f9f6f2' };

				function getFontSize(v) {
					if (v >= 1024) return '1.5rem';
					if (v >= 128) return '1.8rem';
					return '2rem';
				}

				function render() {
					const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
					const styles = isDark ? darkStyles : lightStyles;
					const fallback = isDark ? superDark : superLight;
					boardEl.style.background = isDark ? '#1a1a2e' : '#bbada0';
					boardEl.innerHTML = '';
					for (let r = 0; r < 4; r++) {
						for (let c = 0; c < 4; c++) {
							const v = grid[r][c];
							const cell = document.createElement('div');
							const s = styles[v] || fallback;
							const fs = getFontSize(v);
							cell.style.cssText = `border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;user-select:none;min-height:78px;border:1.5px solid ${isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.12)'};background:${s.bg};color:${s.color};font-size:${fs};font-family:inherit;transition:all 0.12s ease`;
							cell.textContent = v || '';
							boardEl.appendChild(cell);
						}
					}
				}

				function slideRow(row) {
					// Remove zeros
					let arr = row.filter(v => v !== 0);
					let scoreAdded = 0;
					let changed = false;

					// Merge adjacent equal tiles
					for (let i = 0; i < arr.length - 1; i++) {
						if (arr[i] === arr[i + 1]) {
							arr[i] *= 2;
							scoreAdded += arr[i];
							arr.splice(i + 1, 1);
						}
					}

					// Pad with zeros
					while (arr.length < 4) arr.push(0);

					// Check if row changed
					for (let i = 0; i < 4; i++) {
						if (arr[i] !== row[i]) { changed = true; break; }
					}

					return { result: arr, changed, scoreAdded };
				}

				function move(dir) {
					let totalChanged = false;
					let totalScoreAdded = 0;
					const newGrid = Array.from({length: 4}, () => Array(4).fill(0));

					if (dir === 'left') {
						for (let r = 0; r < 4; r++) {
							const { result, changed, scoreAdded } = slideRow([...grid[r]]);
							newGrid[r] = result;
							if (changed) totalChanged = true;
							totalScoreAdded += scoreAdded;
						}
					} else if (dir === 'right') {
						for (let r = 0; r < 4; r++) {
							const reversed = [...grid[r]].reverse();
							const { result, changed, scoreAdded } = slideRow(reversed);
							newGrid[r] = result.reverse();
							if (changed) totalChanged = true;
							totalScoreAdded += scoreAdded;
						}
					} else if (dir === 'up') {
						for (let c = 0; c < 4; c++) {
							const col = [grid[0][c], grid[1][c], grid[2][c], grid[3][c]];
							const { result, changed, scoreAdded } = slideRow(col);
							for (let r = 0; r < 4; r++) newGrid[r][c] = result[r];
							if (changed) totalChanged = true;
							totalScoreAdded += scoreAdded;
						}
					} else if (dir === 'down') {
						for (let c = 0; c < 4; c++) {
							const col = [grid[3][c], grid[2][c], grid[1][c], grid[0][c]];
							const { result, changed, scoreAdded } = slideRow(col);
							for (let r = 0; r < 4; r++) newGrid[3 - r][c] = result[r];
							if (changed) totalChanged = true;
							totalScoreAdded += scoreAdded;
						}
					}

					if (!totalChanged) return false;

					grid = newGrid;
					score += totalScoreAdded;
					scoreEl.textContent = score;

					if (score > highScore) {
						highScore = score;
						localStorage.setItem('2048_high', String(highScore));
						highScoreEl.textContent = highScore;
					}

					addRandom();
					render();

					// Check win
					if (!won) {
						for (let r = 0; r < 4; r++)
							for (let c = 0; c < 4; c++)
								if (grid[r][c] === 2048) {
									won = true;
									overlayTitle.textContent = '恭喜达成 2048!';
									overlayMsg.textContent = '你可以继续挑战更高分数';
									overlay.classList.add('show');
									return true;
								}
					}

					// Check game over
					if (isGameOver()) {
						overlayTitle.textContent = '游戏结束';
						overlayMsg.textContent = `最终得分: ${score}`;
						overlay.classList.add('show');
					}

					return true;
				}

				function isGameOver() {
					for (let r = 0; r < 4; r++)
						for (let c = 0; c < 4; c++) {
							if (grid[r][c] === 0) return false;
							if (c < 3 && grid[r][c] === grid[r][c + 1]) return false;
							if (r < 3 && grid[r][c] === grid[r + 1][c]) return false;
						}
					return true;
				}

				document.addEventListener('keydown', (e) => {
					const key = e.key;
					const map = {
						'ArrowLeft': 'left', 'ArrowRight': 'right',
						'ArrowUp': 'up', 'ArrowDown': 'down',
						'a': 'left', 'A': 'left', 'd': 'right', 'D': 'right',
						'w': 'up', 'W': 'up', 's': 'down', 'S': 'down'
					};
					if (map[key]) {
						e.preventDefault();
						move(map[key]);
					}
				});

				// Touch support
				let touchStartX, touchStartY;
				boardEl.addEventListener('touchstart', (e) => {
					touchStartX = e.touches[0].clientX;
					touchStartY = e.touches[0].clientY;
				}, { passive: true });
				boardEl.addEventListener('touchend', (e) => {
					if (!touchStartX || !touchStartY) return;
					const dx = e.changedTouches[0].clientX - touchStartX;
					const dy = e.changedTouches[0].clientY - touchStartY;
					if (Math.abs(dx) < 30 && Math.abs(dy) < 30) return;
					if (Math.abs(dx) > Math.abs(dy)) {
						move(dx > 0 ? 'right' : 'left');
					} else {
						move(dy > 0 ? 'down' : 'up');
					}
				});

				newBtn.addEventListener('click', init);
				restartBtn.addEventListener('click', init);

				// 主题切换时重新渲染格子颜色
				const observer = new MutationObserver(() => render());
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

				init();
			})();
		</script>
	</body>
</html>
